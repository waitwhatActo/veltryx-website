---
const { title = "Veltryx" } = Astro.props;
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en" class="bg-neutral-950 text-neutral-100">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="icon" href="/favicon.webp" />
    </head>

    <body class="min-h-screen flex flex-col font-sans">
        <div style="background-image: url('/background.webp'); position: fixed; background-size: cover; background-position: center; z-index=-50; height:100vh; width: 100vw;"></div>
        <Navbar />

        <main class="flex-1 px-6 md:px-12 lg:px-20 py-12">
            <div class="max-w-fit mx-auto bg-neutral-800/60 backdrop-blur p-16 rounded-lg shadow-lg drop-shadow-lg">
                <slot />
            </div>
        </main>
        
        <Footer />
    </body>
</html>
