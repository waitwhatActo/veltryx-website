---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout title="Veltryx">
    <div class="max-w-3xl md:w-3xl mx-auto text-center">
        <div class="mb-10 flex justify-center gap-4">
            <img src="/banner_no_outline.webp" alt="Veltryx Banner" class="w-lg" />
        </div>
        <div class="justify-center">
            <h1 class="text-4xl md:text-5xl font-semibold text-neutral-100 pb-4">Welcome to Veltryx.</h1>
            <p class="text-neutral-400 pt-4 text-lg">Hosting provider based in Beautiful British Columbia, Canada.</p>
        </div>

        <div class="mt-10 flex-wrap flex justify-center max-[30rem]:gap-y-4 xs:gap-x-4">
            <a href="/projects" class="px-6 py-3 bg-neutral-800 text-neutral-100 rounded hover:bg-neutral-800">View Projects</a>
            <a href="/about" class="px-6 py-3 border border-neutral-700 text-neutral-300 rounded hover:border-neutral-500">About Veltryx</a>
        </div>
    </div>
</RootLayout>
