---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout title="Veltryx Projects">
    <section class="max-w-5xl mx-auto text-neutral-100">
        <h2 class="text-3xl font-semibold mb-8">Projects</h2>

        <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-neutral-800 p-6 rounded-lg shadow hover:shadow-lg transition">
                <h3 class="text-xl font-bold mb-2">Veltryx Suite</h3>
                <p class="text-neutral-400">Veltryx Suite delivers a fully managed digital experience with secure communication, seamless storage, rich media, and a curated collection of modern services.</p>
            </div>

            <div class="bg-neutral-800 p-6 rounded-lg shadow hover:shadow-lg transition">
                <h3 class="text-xl font-bold mb-2">HomeworkSMP</h3>
                <p class="text-neutral-400">Hosting a community Minecraft server for Acto, delivering a reliable multiplayer experience with seamless gameplay and dedicated infrastructure. <br>Learn more: <a href="https://homeworksmp.gay" class="underline text-cyan-200">https://homeworksmp.gay</a></p>
            </div>

            <div class="bg-neutral-800 p-6 rounded-lg shadow hover:shadow-lg transition">
                <h3 class="text-xl font-bold mb-2">Private Hosting Solutions</h3>
                <p class="text-neutral-400">Co-created and hosted a private organization's website and secure media platform, while providing ongoing management and seamless, secure authentication.</p>
            </div>

            <div class="bg-neutral-800 p-6 rounded-lg shadow hover:shadow-lg transition">
                <h3 class="text-xl font-bold mb-2">Squid Game</h3>
                <p class="text-neutral-400">Engineered and hosted a powerful player-tracking solution for a live Squid Game production, seamlessly coordinating 200 players on the floor in real time.</p>
            </div>
        </div>
    </section>
</RootLayout>
